{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "codex-terminal-themes",
    "version": "1.0.4",
    "description": "Source-of-truth TextMate themes for local Codex and bat terminal highlighting.",
    "keywords": [
        "bat",
        "codex",
        "syntax-highlighting",
        "textmate",
        "themes",
        "tmtheme"
    ],
    "homepage": "https://github.com/Nick2bad4u/codex-terminal-themes#readme",
    "bugs": {
        "url": "https://github.com/Nick2bad4u/codex-terminal-themes/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Nick2bad4u/codex-terminal-themes.git"
    },
    "license": "MIT",
    "author": "Nick2bad4u <20943337+Nick2bad4u@users.noreply.github.com> (https://github.com/Nick2bad4u)",
    "contributors": [
        {
            "name": "Nick2bad4u",
            "email": "20943337+Nick2bad4u@users.noreply.github.com",
            "url": "https://github.com/Nick2bad4u"
        }
    ],
    "sideEffects": false,
    "type": "module",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "default": "./metadata/themes.json"
        },
        "./metadata": {
            "types": "./types/index.d.ts",
            "default": "./metadata/themes.json"
        },
        "./glow/styles/*": "./glow/styles/*",
        "./metadata/themes.json": "./metadata/themes.json",
        "./package.json": "./package.json",
        "./themes/*": "./themes/*"
    },
    "types": "./types/index.d.ts",
    "bin": {
        "codex-terminal-themes": "dist/bin/codex-terminal-themes.js"
    },
    "files": [
        "dist/",
        "docs/assets/",
        "docs/favicon.svg",
        "docs/index.html",
        "docs/preview.svg",
        "docs/styles.css",
        "glow/",
        "metadata/",
        "themes/",
        "types/",
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "LICENSE.txt",
        "README.md",
        "SECURITY.md",
        "stylelint.config.mjs",
        "SUPPORT.md"
    ],
    "scripts": {
        "build": "npm run clean && npm run build:runtime && npm run build:docs && npm run build:pages",
        "build:docs": "tsc --project tsconfig.docs.json",
        "build:pages": "node dist/tools/build-pages-site.js --write",
        "build:runtime": "tsc --project tsconfig.build.json",
        "changelog:generate": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/codex-terminal-themes --output CHANGELOG.md",
        "changelog:preview": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/codex-terminal-themes --unreleased",
        "changelog:release-notes": "git cliff --config node_modules/gitcliff-config-nick2bad4u/cliff.toml --github-repo Nick2bad4u/codex-terminal-themes --current",
        "check": "npm run release:verify",
        "clean": "node -e \"require('node:fs').rmSync('dist', { force: true, recursive: true })\"",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint --cache --cache-strategy content --cache-location .cache/.eslintcache",
        "lint:gitleaks": "gitleaks dir --config .gitleaks.toml .",
        "lint:jscpd": "jscpd --config node_modules/jscpd-config-nick2bad4u/jscpd.json",
        "lint:lychee": "lychee --config node_modules/lychee-config-nick2bad4u/lychee.toml .",
        "lint:lychee:smoke": "lychee --config node_modules/lychee-config-nick2bad4u/lychee.toml --dump-inputs README.md",
        "lint:package-json": "npmPkgJsonLint . --config .npmpackagejsonlintrc.json",
        "lint:remark": "remark . --frail --ignore-path .remarkignore",
        "lint:remark:fix": "remark . --ignore-path .remarkignore --output",
        "lint:yamllint": "yamllint -c .yamllint .",
        "metadata:check": "npm run build:runtime && node dist/tools/generate-theme-metadata.js --check",
        "metadata:write": "npm run build:runtime && node dist/tools/generate-theme-metadata.js --write",
        "pages:build": "npm run build",
        "pages:check": "npm run build && node dist/tools/build-pages-site.js --check",
        "pages:serve": "npm run build && node dist/tools/serve-pages-site.js",
        "pages:test": "npm run typecheck && npm run pages:check",
        "release:verify": "npm run build && npm run validate:built && npm run typecheck && npm run test && npm run lint && npm run format:check && npm run lint:package-json && npm run lint:yamllint",
        "test": "vitest run",
        "typecheck": "tsc --project tsconfig.json --noEmit",
        "update-actions": "npx actions-up --yes --style sha",
        "update-deps": "ncu --configFileName .ncurc.json --configFilePath node_modules/ncu-config-nick2bad4u && npm update --force && npm install --force",
        "validate": "npm run build && npm run validate:built",
        "validate:bat": "npm run build:runtime && node dist/tools/validate-themes.js --bat-cache",
        "validate:built": "node dist/tools/validate-themes.js && node dist/tools/generate-theme-metadata.js --check && node dist/tools/build-pages-site.js --check",
        "validate:themes": "npm run build:runtime && node dist/tools/validate-themes.js"
    },
    "dependencies": {
        "fast-xml-parser": "^5.10.0",
        "fast-xml-validator": "^1.2.0"
    },
    "devDependencies": {
        "@microsoft/tsdoc-config": "^0.18.1",
        "@types/node": "^26.1.1",
        "actions-up": "^1.16.0",
        "eslint": "^10.7.0",
        "eslint-config-nick2bad4u": "^5.0.0",
        "git-cliff": "^2.13.1",
        "gitcliff-config-nick2bad4u": "^1.3.0",
        "gitleaks-config-nick2bad4u": "^1.0.4",
        "jscpd": "^5.0.12",
        "jscpd-config-nick2bad4u": "^1.1.0",
        "lychee-config-nick2bad4u": "^2.0.0",
        "ncu-config-nick2bad4u": "^0.2.0",
        "npm-check-updates": "^22.2.9",
        "npm-package-json-lint": "^10.4.1",
        "npm-package-json-lint-config-nick2bad4u": "^1.0.4",
        "prettier": "^3.9.5",
        "prettier-config-nick2bad4u": "^1.1.1",
        "remark": "^15.0.1",
        "remark-cli": "^12.0.1",
        "remark-config-nick2bad4u": "^1.1.3",
        "secretlint": "^13.0.2",
        "secretlint-config-nick2bad4u": "^1.1.2",
        "stylelint": "^17.14.0",
        "stylelint-config-nick2bad4u": "^1.0.20",
        "tsdoc-config-nick2bad4u": "^1.0.6",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10",
        "yamllint-config-nick2bad4u": "^1.1.1"
    },
    "packageManager": "npm@12.0.1",
    "engines": {
        "node": ">=24"
    },
    "publishConfig": {
        "provenance": true
    }
}
